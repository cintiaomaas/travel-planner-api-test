{
  "openapi": "3.1.0",
  "info": {
    "title": "Viaja Travel Planner API",
    "version": "1.0.0",
    "description": "Documentação interativa da API do Viaja, incluindo conversão de moedas e endpoints de autenticação."
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor atual"
    },
    {
      "url": "https://meu-travel-planner.vercel.app",
      "description": "Produção — Vercel"
    },
    {
      "url": "http://localhost:3000",
      "description": "Desenvolvimento local"
    }
  ],
  "tags": [
    {
      "name": "Documentação",
      "description": "Especificação OpenAPI utilizada pelo Swagger UI."
    },
    {
      "name": "Planejamento",
      "description": "Sincronização dos dados de viagens do usuário autenticado."
    },
    {
      "name": "Câmbio",
      "description": "Conversão de valores entre as moedas suportadas."
    },
    {
      "name": "Autenticação",
      "description": "Endpoints de sessão disponibilizados pelo Auth.js."
    }
  ],
  "paths": {
    "/api/profile": {
      "delete": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Excluir a própria conta",
        "description": "Exclui permanentemente a conta autenticada e seus dados vinculados por cascata, incluindo o planejamento com viagens, atividades e capas enviadas, além de tokens de recuperação de senha. Não recebe corpo, ID ou e-mail: a conta é identificada pelo cookie de sessão do Auth.js. Sessões antigas da conta excluída deixam de ser aceitas. Para limpar testes, execute antes do logout, usando a sessão da conta criada pelo teste. No Swagger, faça login em /login no mesmo servidor e navegador antes de executar. A exclusão não limpa cópias no localStorage nem imagens externas referenciadas por URL.",
        "operationId": "deleteProfile",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Conta excluída com sucesso. Resposta sem corpo."
          },
          "401": {
            "description": "Sessão ausente, inválida ou de uma conta já excluída (UNAUTHORIZED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Perfil não encontrado no momento da exclusão (PROFILE_NOT_FOUND).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Não foi possível excluir a conta (PROFILE_DELETE_UNAVAILABLE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/planner": {
      "get": {
        "tags": [
          "Planejamento"
        ],
        "summary": "Carregar o planejamento sincronizado",
        "description": "Retorna viagens, atividades do roteiro, despesas, checklist, informações e timeline do usuário autenticado. Quando ainda não existem dados sincronizados, `data` e `updatedAt` são nulos. Estados antigos sem atividades retornam `activities: []`.",
        "operationId": "getPlannerState",
        "parameters": [
          {
            "name": "compact",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Substitui capas embutidas por URLs autenticadas, reduzindo o JSON inicial."
          }
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Planejamento carregado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlannerStateResponse"
                }
              }
            }
          },
          "401": {
            "description": "Usuário não autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Os dados armazenados não puderam ser carregados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Falha de conexão com o planejamento (PLANNER_SYNC_UNAVAILABLE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "PLANNER_SYNC_UNAVAILABLE",
                    "message": "Não foi possível conectar ao planejamento. Tente novamente mais tarde."
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Planejamento"
        ],
        "summary": "Sincronizar o planejamento",
        "description": "Substitui o estado sincronizado do usuário autenticado pelo conteúdo completo enviado na requisição. Omitir `activities` equivale a enviar uma lista vazia. Os IDs das atividades devem ser únicos e cada atividade deve referenciar uma viagem enviada. Datas novas ou alteradas devem estar dentro do período da viagem; uma data previamente salva para a mesma atividade e viagem pode ser mantida fora desse período. Despesas vinculadas existentes devem pertencer à mesma viagem. Uma referência a despesa inexistente só pode ser mantida se já estava salva para a mesma atividade e viagem.",
        "operationId": "updatePlannerState",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlannerState"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Planejamento sincronizado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlannerUpdateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Estado de planejamento inválido (INVALID_PLANNER_STATE), incluindo campos ou combinações inválidas da atividade; ou relacionamentos inválidos de atividades (INVALID_ACTIVITY).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Usuário não autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Serviço de sincronização temporariamente indisponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/planner/covers/{key}": {
      "get": {
        "tags": [
          "Planejamento"
        ],
        "summary": "Carregar uma capa do usuário autenticado",
        "operationId": "getPlannerCover",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Imagem com cache privado.",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "304": {
            "description": "A imagem em cache continua atual."
          },
          "401": {
            "description": "Usuário não autenticado."
          },
          "404": {
            "description": "Capa não encontrada para este usuário."
          }
        }
      }
    },
    "/api/openapi": {
      "get": {
        "tags": [
          "Documentação"
        ],
        "summary": "Obter a especificação OpenAPI",
        "description": "Retorna o documento OpenAPI 3.1 exibido pelo Swagger UI.",
        "operationId": "getOpenApiDocument",
        "responses": {
          "200": {
            "description": "Especificação OpenAPI atual da aplicação.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "openapi",
                    "info",
                    "paths"
                  ],
                  "properties": {
                    "openapi": {
                      "type": "string",
                      "example": "3.1.0"
                    },
                    "info": {
                      "type": "object"
                    },
                    "paths": {
                      "type": "object"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/currency": {
      "get": {
        "tags": [
          "Câmbio"
        ],
        "summary": "Converter um valor entre moedas",
        "description": "Consulta a cotação na Frankfurter. Se o provedor estiver indisponível, usa `manualRate` quando informado. Conversões entre moedas iguais são calculadas localmente.",
        "operationId": "convertCurrency",
        "parameters": [
          {
            "name": "amount",
            "in": "query",
            "description": "Valor positivo a converter. O padrão é 1.",
            "schema": {
              "type": "number",
              "format": "double",
              "exclusiveMinimum": 0,
              "maximum": 1000000000,
              "default": 1
            },
            "example": 100
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Moeda de origem.",
            "schema": {
              "$ref": "#/components/schemas/Currency"
            },
            "example": "EUR"
          },
          {
            "name": "to",
            "in": "query",
            "description": "Moeda de destino. O padrão é BRL.",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Currency"
                }
              ],
              "default": "BRL"
            },
            "example": "BRL"
          },
          {
            "name": "manualRate",
            "in": "query",
            "description": "Cotação manual positiva, usada somente se o provedor online falhar.",
            "schema": {
              "type": "number",
              "format": "double",
              "exclusiveMinimum": 0,
              "maximum": 1000000
            },
            "example": 6.42
          }
        ],
        "responses": {
          "200": {
            "description": "Conversão realizada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CurrencyConversion"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros de consulta inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno inesperado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "O provedor de cotações está indisponível e nenhuma cotação manual foi fornecida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/providers": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Listar provedores de autenticação",
        "operationId": "listAuthProviders",
        "responses": {
          "200": {
            "description": "Provedores configurados no Auth.js.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/components/schemas/AuthProvider"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Solicitar redefinição de senha",
        "description": "Envia um link de uso único, válido por 30 minutos. A resposta não revela se o e-mail está cadastrado.",
        "operationId": "requestPasswordReset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254,
                    "example": "viajante@exemplo.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Solicitação processada sem revelar a existência da conta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "E-mail inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Redefinir a senha",
        "description": "Recebe o token original presente no link enviado por e-mail e a nova senha. Não envie o `csrfToken` do login nem o `tokenHash` de 64 caracteres armazenado no banco; nenhum deles é um token de redefinição.",
        "operationId": "resetPassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordReset"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha redefinida com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Token inválido ou expirado, ou senha inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/register": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Criar uma conta de usuário",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegistration"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conta criada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/RegisteredUser"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados de cadastro inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "E-mail já cadastrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Cadastro temporariamente indisponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Obter token CSRF",
        "description": "Retorna o token de proteção usado pelo Auth.js em login, logout e atualização de sessão. Este token não redefine senha e não deve ser enviado para `/api/auth/reset-password`.",
        "operationId": "getCsrfToken",
        "responses": {
          "200": {
            "description": "Token necessário para operações de login e logout.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "csrfToken"
                  ],
                  "properties": {
                    "csrfToken": {
                      "type": "string",
                      "description": "Token CSRF da sessão do navegador; não é um token de redefinição de senha."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Consultar a sessão atual",
        "operationId": "getSession",
        "security": [
          {},
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sessão atual ou `null` quando o usuário não está autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Session"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Atualizar a sessão atual",
        "description": "Operação disponibilizada pelo Auth.js para atualizar dados da sessão. Requer o token retornado por `GET /api/auth/csrf`.",
        "operationId": "updateSession",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessão atualizada ou `null` se não houver sessão ativa.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Session"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/callback/credentials": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Entrar com e-mail e senha",
        "description": "Recebe as credenciais após a consulta `GET /api/auth/csrf`. O cliente da aplicação envia `X-Auth-Return-Redirect: 1` e recebe uma resposta JSON com a URL de destino.",
        "operationId": "signInWithCredentials",
        "parameters": [
          {
            "name": "X-Auth-Return-Redirect",
            "in": "header",
            "description": "Solicita que o Auth.js devolva a URL em JSON, sem redirecionar imediatamente.",
            "schema": {
              "type": "string",
              "const": "1",
              "default": "1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsCallback"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login processado. Falhas de credenciais são informadas nos parâmetros da URL retornada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthRedirectResponse"
                }
              }
            }
          },
          "302": {
            "description": "Redirecionamento usado quando o cabeçalho `X-Auth-Return-Redirect` não é enviado."
          }
        }
      }
    },
    "/api/auth/signout": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Encerrar a sessão",
        "operationId": "signOut",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Return-Redirect",
            "in": "header",
            "description": "Solicita que o Auth.js devolva a URL em JSON, sem redirecionar imediatamente.",
            "schema": {
              "type": "string",
              "const": "1",
              "default": "1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "csrfToken"
                ],
                "properties": {
                  "csrfToken": {
                    "type": "string"
                  },
                  "callbackUrl": {
                    "type": "string",
                    "format": "uri-reference",
                    "default": "/"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessão encerrada e URL de retorno informada em JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthRedirectResponse"
                }
              }
            }
          },
          "302": {
            "description": "Redirecionamento usado quando o cabeçalho `X-Auth-Return-Redirect` não é enviado."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "authjs.session-token",
        "description": "Cookie de sessão gerenciado pelo Auth.js. Em HTTPS, o nome pode receber o prefixo `__Secure-`."
      }
    },
    "schemas": {
      "PlannerStateResponse": {
        "type": "object",
        "required": [
          "data",
          "updatedAt"
        ],
        "properties": {
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PlannerState"
              },
              {
                "type": "null"
              }
            ]
          },
          "updatedAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "PlannerUpdateResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "updatedAt"
            ],
            "properties": {
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "PlannerState": {
        "type": "object",
        "required": [
          "trips",
          "expenses",
          "checklist",
          "selectedTripId",
          "tripInfo",
          "timeline"
        ],
        "properties": {
          "activities": {
            "type": "array",
            "maxItems": 10000,
            "default": [],
            "description": "Atividades do roteiro. Campo opcional; quando omitido, assume uma lista vazia, inclusive ao substituir o planejamento.",
            "items": {
              "$ref": "#/components/schemas/Activity"
            }
          },
          "trips": {
            "type": "array",
            "maxItems": 250,
            "items": {
              "$ref": "#/components/schemas/Trip"
            }
          },
          "expenses": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "$ref": "#/components/schemas/Expense"
            }
          },
          "checklist": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "$ref": "#/components/schemas/ChecklistGroup"
            }
          },
          "selectedTripId": {
            "type": "string",
            "maxLength": 220
          },
          "tripInfo": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/TripInfo"
            }
          },
          "timeline": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "maxItems": 5000,
              "items": {
                "$ref": "#/components/schemas/TimelineItem"
              }
            }
          }
        }
      },
      "Activity": {
        "type": "object",
        "required": [
          "id",
          "tripId",
          "name",
          "date",
          "category",
          "status"
        ],
        "description": "Atividade do roteiro. Quando expenseId é informado, estimate e currency devem ser omitidos: os valores vêm do orçamento. Informar estimate exige currency.",
        "dependentRequired": {
          "estimate": [
            "currency"
          ]
        },
        "allOf": [
          {
            "if": {
              "required": [
                "expenseId"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "estimate"
                    ]
                  },
                  {
                    "required": [
                      "currency"
                    ]
                  }
                ]
              }
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "tripId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "Nome após remoção dos espaços nas extremidades."
          },
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-10-15"
          },
          "time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "example": "09:30"
          },
          "duration": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 525600,
            "description": "Duração em minutos."
          },
          "city": {
            "type": "string",
            "maxLength": 160
          },
          "address": {
            "type": "string",
            "maxLength": 1000
          },
          "category": {
            "type": "string",
            "enum": [
              "passeio",
              "alimentação",
              "transporte",
              "hospedagem",
              "outro"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "planejado",
              "reservado",
              "concluído"
            ]
          },
          "estimate": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "bookingUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://",
            "description": "Link de reserva HTTP ou HTTPS."
          },
          "notes": {
            "type": "string",
            "maxLength": 20000
          },
          "expenseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "distanceKm": {
            "type": "number",
            "minimum": 0,
            "description": "Distância em quilômetros."
          },
          "travelHours": {
            "type": "number",
            "minimum": 0,
            "description": "Tempo de deslocamento em horas, aceitando frações."
          }
        }
      },
      "Trip": {
        "type": "object",
        "required": [
          "id",
          "name",
          "destination",
          "country",
          "startDate",
          "endDate",
          "dateLabel",
          "travelers",
          "budget",
          "currency",
          "status",
          "total",
          "paid",
          "daysRemaining",
          "coverImage",
          "accent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 220
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "destination": {
            "type": "string",
            "maxLength": 120
          },
          "country": {
            "type": "string",
            "maxLength": 120
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "dateLabel": {
            "type": "string",
            "maxLength": 100
          },
          "travelers": {
            "type": "number",
            "minimum": 0
          },
          "budget": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "const": "BRL"
          },
          "status": {
            "type": "string",
            "enum": [
              "Planejada",
              "Em andamento",
              "Concluída"
            ]
          },
          "total": {
            "type": "number"
          },
          "paid": {
            "type": "number"
          },
          "daysRemaining": {
            "type": "number"
          },
          "coverImage": {
            "type": "string",
            "maxLength": 3000000
          },
          "coverImageAttribution": {
            "type": "string",
            "maxLength": 2000
          },
          "coverImageLicense": {
            "type": "string",
            "maxLength": 500
          },
          "coverImageSourceUrl": {
            "type": "string",
            "maxLength": 5000
          },
          "accent": {
            "type": "string",
            "maxLength": 40
          }
        }
      },
      "Expense": {
        "type": "object",
        "required": [
          "id",
          "tripId",
          "category",
          "description",
          "quantity",
          "unitPrice",
          "currency",
          "exchangeRate",
          "convertedAmount",
          "paid"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 220
          },
          "tripId": {
            "type": "string",
            "maxLength": 220
          },
          "category": {
            "type": "string",
            "enum": [
              "Hospedagem",
              "Passagens",
              "Transporte",
              "Alimentação",
              "Passeios",
              "Outros"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 160
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "unitPrice": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "exchangeRate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "convertedAmount": {
            "type": "number",
            "minimum": 0
          },
          "paid": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "maxLength": 20000
          }
        }
      },
      "ChecklistGroup": {
        "type": "object",
        "required": [
          "id",
          "title",
          "icon",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 220
          },
          "tripId": {
            "type": "string",
            "maxLength": 220
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "icon": {
            "type": "string",
            "enum": [
              "documents",
              "reservations",
              "finance",
              "luggage"
            ]
          },
          "items": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/ChecklistItem"
            }
          }
        }
      },
      "ChecklistItem": {
        "type": "object",
        "required": [
          "id",
          "label",
          "done"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 220
          },
          "label": {
            "type": "string",
            "maxLength": 160
          },
          "done": {
            "type": "boolean"
          }
        }
      },
      "TripInfo": {
        "type": "object",
        "properties": {
          "accommodation": {
            "type": "string",
            "maxLength": 20000
          },
          "accommodationDetails": {
            "type": "string",
            "maxLength": 20000
          },
          "flight": {
            "type": "string",
            "maxLength": 20000
          },
          "flightDetails": {
            "type": "string",
            "maxLength": 20000
          },
          "transport": {
            "type": "string",
            "maxLength": 20000
          },
          "documents": {
            "type": "string",
            "maxLength": 20000
          },
          "usefulLink": {
            "type": "string",
            "maxLength": 20000
          },
          "notes": {
            "type": "string",
            "maxLength": 20000
          }
        }
      },
      "TimelineItem": {
        "type": "object",
        "required": [
          "id",
          "date",
          "day",
          "title",
          "subtitle",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 220
          },
          "sourceExpenseId": {
            "type": "string",
            "maxLength": 220
          },
          "automatic": {
            "type": "boolean"
          },
          "date": {
            "type": "string",
            "maxLength": 40
          },
          "dateValue": {
            "type": "string",
            "format": "date"
          },
          "day": {
            "type": "string",
            "maxLength": 40
          },
          "time": {
            "type": "string",
            "maxLength": 10
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "subtitle": {
            "type": "string",
            "maxLength": 20000
          },
          "type": {
            "type": "string",
            "enum": [
              "Financeiro",
              "Voos",
              "Hospedagem",
              "Passeios",
              "Checklist"
            ]
          }
        }
      },
      "Currency": {
        "type": "string",
        "enum": [
          "BRL",
          "USD",
          "EUR",
          "ARS",
          "GBP",
          "CLP",
          "JPY",
          "CAD",
          "AUD",
          "CHF",
          "MXN",
          "UYU"
        ]
      },
      "CurrencyConversion": {
        "type": "object",
        "required": [
          "amount",
          "from",
          "to",
          "rate",
          "convertedAmount",
          "quotationDate",
          "source"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "example": 100
          },
          "from": {
            "$ref": "#/components/schemas/Currency"
          },
          "to": {
            "$ref": "#/components/schemas/Currency"
          },
          "rate": {
            "type": "number",
            "format": "double",
            "example": 6.42
          },
          "convertedAmount": {
            "type": "number",
            "format": "double",
            "example": 642
          },
          "quotationDate": {
            "type": "string",
            "format": "date",
            "example": "2026-07-13"
          },
          "source": {
            "type": "string",
            "enum": [
              "frankfurter",
              "manual-fallback",
              "identity"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "INTERNAL_ERROR"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "object",
                "properties": {
                  "fields": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "ServiceErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "object",
                "properties": {
                  "manualRateAccepted": {
                    "type": "boolean",
                    "const": true
                  }
                }
              }
            ]
          }
        }
      },
      "AuthProvider": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "signinUrl",
          "callbackUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "credentials"
          },
          "name": {
            "type": "string",
            "example": "E-mail e senha"
          },
          "type": {
            "type": "string",
            "example": "credentials"
          },
          "signinUrl": {
            "type": "string",
            "format": "uri"
          },
          "callbackUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "user",
          "expires"
        ],
        "properties": {
          "user": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "email"
              },
              "image": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            }
          },
          "expires": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "SessionUpdate": {
        "type": "object",
        "required": [
          "csrfToken",
          "data"
        ],
        "properties": {
          "csrfToken": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "description": "Dados encaminhados ao callback JWT do Auth.js.",
            "additionalProperties": true
          }
        }
      },
      "CredentialsCallback": {
        "type": "object",
        "required": [
          "email",
          "password",
          "csrfToken"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 128
          },
          "csrfToken": {
            "type": "string"
          },
          "callbackUrl": {
            "type": "string",
            "format": "uri-reference",
            "default": "/"
          }
        }
      },
      "AuthRedirectResponse": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri-reference",
            "description": "URL de destino. Em uma falha de autenticação, pode conter os parâmetros `error` e `code`.",
            "example": "/"
          }
        }
      },
      "UserRegistration": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 128
          }
        }
      },
      "RegisteredUser": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "PasswordReset": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "Token original recebido no parâmetro `token` do link enviado por e-mail. Não é o `csrfToken` do login nem o `tokenHash` salvo no banco.",
            "example": "kT2xY8nQ4pL7vR1mC6sW9aB3dF5hJ0uE2iO8gZ1cVqM"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 128,
            "description": "Nova senha que substituirá a senha atual.",
            "example": "NovaSenha123!"
          }
        }
      }
    }
  }
}
